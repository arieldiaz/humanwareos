# The complete data plane lives outside this repository. These are tripwires.
/stream/
/memory/
/sessions/
/workspaces/
/artifacts/
/imports/
/derived/
/cache/

# Per-machine reading-surface state.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json

# Machine-local pipeline config.
ops/stream-paths.env

# Secrets.
# Real values live in the secrets manager (infra/secrets/runbook.md;
# Doppler by default). .env files never get committed; .env.example
# placeholders do.
.env
.env.*
!.env.example

# macOS noise.
.DS_Store

# Harness shim: Claude Code only auto-loads a file named CLAUDE.md; keep it local, canonical rules live in AGENTS.md
/CLAUDE.md
