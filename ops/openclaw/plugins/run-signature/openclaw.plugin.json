{
  "id": "run-signature",
  "name": "Run Signature",
  "description": "Per-message reaction signatures, human status-event capture, owner thread closure, and model switching for Slack conversations.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": ["start_work_thread", "close_thread", "switch_model"]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "defaultSlackAccount": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
      "dataRoot": {"type": "string", "pattern": "^/"},
      "humanStatusActors": {
        "type": "array",
        "items": {"type": "string", "pattern": "^[A-Z0-9]+$"},
        "uniqueItems": true
      },
      "excludedChannels": {
        "type": "array",
        "items": {"type": "string", "pattern": "^[A-Z0-9]+$"},
        "uniqueItems": true
      }
    },
    "additionalProperties": false
  }
}
