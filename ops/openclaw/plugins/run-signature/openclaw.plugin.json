{
  "id": "run-signature",
  "name": "Run Signature",
  "description": "Adds per-message reaction signatures and maintains the root lifecycle tile.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": ["start_work_thread", "close_thread"]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "defaultSlackAccount": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
      "dataRoot": {"type": "string", "pattern": "^/"},
      "excludedChannels": {
        "type": "array",
        "items": {"type": "string", "pattern": "^[A-Z0-9]+$"},
        "uniqueItems": true
      }
    },
    "additionalProperties": false
  }
}
