# Copy to ops/stream-paths.env and edit. That copy is gitignored —
# paths and hostnames are machine-local config, not framework.

# ── Mac mini (canonical + compute) ───────────────────────────
STREAM_CANONICAL="/Users/you/Stream"           # where captures land on the mini
DATA_ROOT="$HOME/humanwareos-data"             # external data plane; never a Git checkout

# ── Whisper (open-source, local) ─────────────────────────────
# mlx-whisper is the fast choice on Apple Silicon: pip install mlx-whisper
# Alternatives: openai-whisper CLI ("whisper"), or a whisper.cpp wrapper.
# Flags in transcribe-watch.sh follow the standard whisper CLI shape —
# adjust there if your install differs.
WHISPER_CMD="mlx_whisper"
WHISPER_MODEL="mlx-community/whisper-large-v3-turbo"

# ── Performance gates (see ops/lib/gate.sh) ──────────────────
# Heavy jobs (transcribe, backup) defer to a later launchd tick whenever the
# machine is busy. Defaults work everywhere; override here.
# PERF_GATE_APPS="OBS"        # processes that block heavy work; "" disables
# PERF_IDLE_SECS=300          # user must be idle this long; 0 disables
# PERF_GATE_ON_BATTERY=1      # defer heavy work on battery
# PERF_GATE_DISPLAY=0         # also defer during calls/media (aggressive)

# ── QNAP NAS (backup, ethernet to mini) ──────────────────────
NAS_BACKUP_DIR="/Volumes/QNAP/stream-backup"   # mounted SMB path ON THE MINI

# ── Backup (restic) ──────────────────────────────────────────
# The passphrase is not stored here. Headless hosts default to
# `~/.config/humanwareos/restic-password` with mode 600.
# See ops/lib/restic-lib.sh and ops/README.md.
#
# Mini → external SSD (monthly, manual). Local repo on the mounted drive:
# BACKUP_SSD_REPO="/Volumes/Backup/restic/mini"
# BACKUP_SSD_MOUNT="/Volumes/Backup"     # abort if this isn't mounted
# BACKUP_MINI_PATHS=( "$HOME/humanwareos-data" )                    # unset = sensible default
#
# RESTIC_EXCLUDE_FILE="$OPS_DIR/backup/exclude.txt"   # copy from exclude.txt.example
# RESTIC_BWLIMIT=8192      # KiB/s upload cap; "" uncaps
# RESTIC_KEEP_DAILY=7      # retention for forget --prune
# RESTIC_KEEP_WEEKLY=8
# RESTIC_KEEP_MONTHLY=12
