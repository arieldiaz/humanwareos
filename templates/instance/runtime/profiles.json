    },
    "cursor": {
      "runtime": "acp",
      "harness": "cursor",
      "model": "cursor-default",
      "permissions": "standard",
      "workspace": "required",
      "dataScope": "tier-2"
    },
    "codex": {
      "runtime": "acp",
      "harness": "codex",
      "model": "gpt-5.6-sol",
      "permissions": "standard",
      "workspace": "required",
      "dataScope": "tier-2"
    }
  }
}
