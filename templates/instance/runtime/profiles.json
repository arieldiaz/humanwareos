{
  "schemaVersion": 1,
  "defaultProfile": "native-default",
  "agents": {
    "liv": {
      "defaultProfile": "native-default",
      "allowedProfiles": ["native-default", "cursor", "codex"]
    },
    "max": {
      "defaultProfile": "native-default",
      "allowedProfiles": ["native-default", "cursor", "codex"]
    }
  },
  "profiles": {
