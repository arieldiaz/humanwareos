{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanwareos.com/schemas/artifact-registry.schema.json",
  "title": "Humanware OS artifact registry",
  "type": "object",
  "required": ["schemaVersion", "projects"],
  "properties": {
    "schemaVersion": {"const": 1},
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "artifacts"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "name": {"type": "string", "minLength": 1},
          "artifacts": {
            "type": "array",
            "items": {"$ref": "#/$defs/artifact"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "artifact": {
      "type": "object",
      "required": ["id", "project", "title", "number", "date_label", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "project": {"$ref": "#/$defs/slug"},
        "title": {"type": "string", "minLength": 1},
        "number": {"type": ["string", "integer"]},
        "date_label": {"type": "string", "minLength": 1},
        "type": {"const": "html"},
        "target": {"type": "string", "minLength": 1},
        "supersedes": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
