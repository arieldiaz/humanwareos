{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanwareos.com/schemas/artifact-registry.schema.json",
  "title": "Humanware OS artifact registry",
  "type": "object",
  "required": ["schemaVersion", "projects"],
  "properties": {
    "schemaVersion": {"const": 2},
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "artifacts"],
        "properties": {
          "id": {"$ref": "versioned-item.schema.json#/$defs/slug"},
          "name": {"type": "string", "minLength": 1},
          "aliases": {
            "type": "array",
            "items": {"$ref": "versioned-item.schema.json#/$defs/slug"}
          },
          "artifacts": {
            "type": "array",
            "items": {"$ref": "#/$defs/artifact"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "description": "A stable artifact is a versioned item (docs/versioning.md). Its url is derived as /artifacts/<project>/<id>/.",
      "type": "object",
      "required": ["id", "project", "title", "type", "current_version", "versions"],
      "properties": {
        "id": {"$ref": "versioned-item.schema.json#/$defs/slug"},
        "project": {"$ref": "versioned-item.schema.json#/$defs/slug"},
        "title": {"type": "string", "minLength": 1},
        "type": {"const": "html"},
        "target": {"type": "string", "minLength": 1},
        "session": {"type": "string", "minLength": 1, "description": "Key of the working session whose promotions append versions to this artifact."},
        "current_version": {"$ref": "versioned-item.schema.json#/$defs/slug"},
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "versioned-item.schema.json#/$defs/version"}
        }
      },
      "additionalProperties": false
    }
  }
}
