{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanwareos.com/schemas/instance.schema.json",
  "title": "Humanware OS instance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "paths", "agents", "openclaw", "runtimeProfiles", "channels", "surfaces", "services", "secrets"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataRoot", "runtimeRoot", "worktreeRoot"],
      "properties": {
        "dataRoot": {"type": "string", "pattern": "^/"},
        "runtimeRoot": {"type": "string", "pattern": "^/"},
        "worktreeRoot": {"type": "string", "pattern": "^/"}
      }
    },
    "agents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "openclaw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "config", "plugins"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-.][A-Za-z0-9.-]+)?$"},
        "config": {"const": "openclaw/config.patch.json5"},
        "plugins": {"type": "array", "items": {"type": "string"}}
      }
    },
    "runtimeProfiles": {"type": "string"},
    "channels": {"type": "array", "items": {"type": "string"}},
    "surfaces": {"type": "array", "items": {"type": "string"}},
    "services": {"type": "array", "items": {"type": "string"}},
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "bootstrap"],
      "properties": {
        "provider": {"type": "string"},
        "bootstrap": {"enum": ["external"]},
        "openclawProvider": {"type": "string"}
      }
    }
  }
}
