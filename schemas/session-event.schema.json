{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanwareos.com/schemas/session-event.schema.json",
  "title": "Humanware OS normalized session event",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "traceId",
    "ts",
    "logicalSessionId",
    "source",
    "kind",
    "level",
    "summary",
    "details"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "minLength": 1},
    "traceId": {"type": "string", "minLength": 1},
    "ts": {"type": "string", "format": "date-time"},
    "logicalSessionId": {"type": "string", "minLength": 1},
    "runtimeSessionId": {"type": ["string", "null"]},
    "runId": {"type": ["string", "null"]},
    "turnId": {"type": ["string", "null"]},
    "agent": {"type": ["string", "null"]},
    "source": {"type": "string", "minLength": 1},
    "provider": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "profileId": {"type": ["string", "null"]},
    "harness": {"type": ["string", "null"]},
    "kind": {"type": "string", "minLength": 1},
    "level": {"enum": ["normal", "verbose", "forensic"]},
    "summary": {"type": "string"},
    "details": {"type": "object"},
    "sourceRef": {
      "type": "object",
      "properties": {
        "file": {"type": "string"},
        "seq": {"type": ["integer", "null"]},
        "sessionKey": {"type": ["string", "null"]},
        "runId": {"type": ["string", "null"]},
        "messageId": {"type": ["string", "null"]}
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "status"],
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1},
          "status": {"enum": ["addressed", "deferred", "blocked"]}
        },
        "additionalProperties": false
      }
    }
  }
}
