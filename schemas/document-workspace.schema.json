{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanwareos.com/schemas/document-workspace.schema.json",
  "title": "Humanware OS document workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "dataRoot", "proposalDirectory", "collections"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "dataRoot": {"type": "string", "pattern": "^/"},
    "proposalDirectory": {"type": "string", "pattern": "^/"},
    "maxFileBytes": {"type": "integer", "minimum": 1024, "maximum": 5242880},
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "root", "extensions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "label": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "root": {"type": "string", "pattern": "^/"},
          "extensions": {"type": "array", "minItems": 1, "items": {"enum": [".md", ".txt", ".json", ".yaml", ".yml", ".pdf"]}},
          "exclude": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
