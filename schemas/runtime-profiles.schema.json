{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanwareos.com/schemas/runtime-profiles.schema.json",
  "title": "Humanware OS execution profiles",
  "type": "object",
  "required": ["schemaVersion", "defaultProfile", "agents", "profiles"],
  "properties": {
    "schemaVersion": {"const": 1},
    "defaultProfile": {"type": "string"},
    "agents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["defaultProfile", "allowedProfiles"],
        "properties": {
          "defaultProfile": {"type": "string", "minLength": 1},
          "allowedProfiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["runtime", "harness", "model", "permissions", "workspace", "dataScope"],
        "properties": {
          "runtime": {"enum": ["native", "acp"]},
          "harness": {"type": "string"},
          "model": {"type": "string"},
          "permissions": {"enum": ["read-only", "standard", "elevated"]},
          "workspace": {"enum": ["none", "isolated-on-write", "required"]},
          "dataScope": {"type": "string"},
          "backend": {"type": "string"},
          "mode": {"enum": ["persistent", "oneshot"]},
          "enabled": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  }
}
